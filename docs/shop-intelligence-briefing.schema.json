{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bootcamp/shop-intelligence-briefing.schema.json",
  "title": "Shop intelligence briefing",
  "description": "Advisor-facing card. Every numeric claim is FACT, INFERRED, or UNKNOWN. Do not fill gaps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "generated_at",
    "vehicle_match",
    "evidence",
    "common_reasons",
    "parts",
    "ticket",
    "time",
    "gotchas",
    "likelihood",
    "recommendations",
    "not_in_data",
    "guardrail"
  ],
  "properties": {
    "query": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "vehicle_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grain", "identity", "tag", "note"],
      "properties": {
        "grain": { "enum": ["vin", "year_make_model_engine", "year_make_model", "unmatched"] },
        "identity": { "type": ["string", "null"] },
        "year": { "type": ["integer", "null"] },
        "make": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "engine": { "type": ["string", "null"] },
        "vin": { "type": ["string", "null"] },
        "tag": { "enum": ["FACT", "INFERRED", "UNKNOWN"] },
        "note": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_count", "date_start", "date_end", "tag"],
      "properties": {
        "order_count": { "type": "integer", "minimum": 0 },
        "date_start": { "type": ["string", "null"], "format": "date" },
        "date_end": { "type": ["string", "null"], "format": "date" },
        "tag": { "enum": ["FACT", "UNKNOWN"] }
      }
    },
    "common_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "order_count", "share", "source", "tag", "example_order_ids"],
        "properties": {
          "label": { "type": "string" },
          "order_count": { "type": "integer", "minimum": 0 },
          "share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "source": { "enum": ["order_service_name", "inspection_recommended", "deferred_service", "note"] },
          "tag": { "enum": ["FACT", "INFERRED"] },
          "example_order_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sku", "times_sold", "last_seen", "tag"],
        "properties": {
          "name": { "type": "string" },
          "sku": { "type": ["string", "null"] },
          "times_sold": { "type": "integer", "minimum": 0 },
          "last_seen": { "type": ["string", "null"], "format": "date" },
          "avg_part_cost_usd": { "type": ["number", "null"] },
          "tag": { "enum": ["FACT"] }
        }
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_with_amount", "typical_usd", "best_observed_usd", "worst_observed_usd", "method", "tag"],
      "properties": {
        "n_with_amount": { "type": "integer", "minimum": 0 },
        "typical_usd": { "type": ["number", "null"] },
        "best_observed_usd": { "type": ["number", "null"] },
        "worst_observed_usd": { "type": ["number", "null"] },
        "method": { "type": "string" },
        "tag": { "enum": ["FACT", "INFERRED", "UNKNOWN"] }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_with_hours", "n_missing_hours", "typical_hours", "tag", "note"],
      "properties": {
        "n_with_hours": { "type": "integer", "minimum": 0 },
        "n_missing_hours": { "type": "integer", "minimum": 0 },
        "typical_hours": { "type": ["number", "null"] },
        "tag": { "enum": ["FACT", "INFERRED", "UNKNOWN"] },
        "note": { "type": "string" }
      }
    },
    "gotchas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label", "count", "tag", "source_order_ids"],
        "properties": {
          "kind": { "enum": ["inspection_recommended_not_sold", "deferred_service", "comeback_within_window", "note"] },
          "label": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "tag": { "enum": ["FACT"] },
          "source_order_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 10 }
        }
      }
    },
    "likelihood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_reason", "percent", "n", "best_case", "worst_case", "tag", "statement"],
      "properties": {
        "selected_reason": { "type": ["string", "null"] },
        "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "n": { "type": "integer", "minimum": 0 },
        "best_case": { "type": "string" },
        "worst_case": { "type": "string" },
        "tag": { "enum": ["INFERRED", "UNKNOWN"] },
        "statement": { "type": "string" }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "because", "tag"],
        "properties": {
          "action": { "type": "string" },
          "because": { "type": "string" },
          "tag": { "enum": ["FACT", "INFERRED"] }
        }
      }
    },
    "not_in_data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "why"],
        "properties": {
          "topic": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_fill", "human_gate"],
      "properties": {
        "no_fill": { "type": "boolean", "const": true },
        "human_gate": { "type": "string" }
      }
    }
  }
}
