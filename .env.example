# Copy to .env and fill in your key. Never commit .env or paste keys in chat.
# Format MUST include the equals sign:
OPENAI_API_KEY=sk-proj-your-key-here

# AI FinOps controls (local defaults)
AI_FINOPS_DB_PATH=data/finops.sqlite3
AI_DAILY_BUDGET_USD=5.00
AI_ALERT_THRESHOLD_PCT=0.80
AI_HARD_STOP_ENABLED=false

# Configured planning rates per 1M tokens; reconcile with provider pricing.
OPENAI_INPUT_USD_PER_M=0.15
OPENAI_CACHED_INPUT_USD_PER_M=0.075
OPENAI_OUTPUT_USD_PER_M=0.60

# ShopMonkey REST v3 (Settings → Integration → API Keys). Never commit the key.
SHOPMONKEY_API_KEY=replace-me
