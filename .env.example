# Copy to .env and fill in your key. Never commit .env or paste keys in chat.
OPENAI_API_KEY=sk-proj-your-key-here
# Light /ask spend guards (optional) — Q&A wallet
ASK_MAX_TOKENS=300
ASK_MAX_USD=1.0
# Optional /analyze LLM classifier — separate wallet (default OFF via use_llm_classifier=false)
CLASSIFIER_MAX_TOKENS=300
CLASSIFIER_MAX_USD=0.50
# ANALYZE_MAX_USD=0.50
# Set when predicted classifier cost > $0.05 or daily remaining < $0.10 (or pass classifier_spend_approved)
# CLASSIFIER_SPEND_APPROVED=1
